# Where the Nest API is listening. Used by the dev proxy in vite.config.ts.
# Your API defaults to 3000; set this if you changed PORT.
VITE_API_PROXY_TARGET=http://localhost:3000

# Only for builds served from a different origin than the API. Leave unset in
# dev — the app then calls the same-origin "/api" path that the proxy handles.
# VITE_API_URL=https://api.example.com

# Cross-origin deployment note: the session is an httpOnly cookie, so serving
# this app from a different origin than the API needs, on the API side,
# enableCors({ origin: '<this app origin>', credentials: true }) and a cookie
# marked SameSite=None; Secure. The dev proxy above avoids all of that by
# keeping every request same-origin.
